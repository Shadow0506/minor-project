<?xml version="1.0" ?>

<!--
  Q-Learning Swarm Experiment Configuration
  
  This file configures the ARGoS simulation environment:
  - 20x20m arena
  - 4 FootBots with Q-learning controllers
  - Goal position at (18, 18)
  - Physics engine settings
  - Visualization settings
-->

<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment length="0"
                ticks_per_second="10"
                random_seed="124" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <q_swarm_controller id="qsc"
                        library="/home/shadow56/Desktop/minor-project/controllers/q_swarm_controller/build/libq_swarm_controller">
      <actuators>
        <differential_steering implementation="default" />
      </actuators>
      <sensors>
        <footbot_proximity implementation="default" show_rays="true" />
        <positioning implementation="default" />
      </sensors>
      <params goal_x="18.0" goal_y="18.0" velocity="15.0" max_steps="1000" max_episodes="1000" />

    </q_swarm_controller>

  </controllers>

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="20, 20, 2" center="10, 10, 1">

    <!-- Floor -->
    <floor id="floor"
           source="loop_functions"
           pixels_per_meter="50" />

    <!-- Arena walls (outer boundary) -->
    <box id="wall_north" size="20, 0.1, 0.5" movable="false">
      <body position="10, 20, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_south" size="20, 0.1, 0.5" movable="false">
      <body position="10, 0, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_east" size="0.1, 20, 0.5" movable="false">
      <body position="20, 10, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_west" size="0.1, 20, 0.5" movable="false">
      <body position="0, 10, 0" orientation="0, 0, 0" />
    </box>

    <!-- War zone obstacles - scattered debris and barriers -->
    
    <!-- Central barrier (simulating destroyed wall) -->
    <box id="barrier_1" size="4, 0.3, 0.5" movable="false">
      <body position="10, 10, 0" orientation="0, 0, 0.3" />
    </box>
    
    <!-- Scattered obstacles (debris, rubble) -->
    <box id="obstacle_1" size="1.5, 1.5, 0.5" movable="false">
      <body position="8, 6, 0" orientation="0, 0, 0.5" />
    </box>
    
    <box id="obstacle_2" size="1, 2, 0.5" movable="false">
      <body position="12, 8, 0" orientation="0, 0, 0.8" />
    </box>
    
    <box id="obstacle_3" size="2, 1, 0.5" movable="false">
      <body position="6, 12, 0" orientation="0, 0, 0.2" />
    </box>
    
    <box id="obstacle_4" size="1.5, 1.5, 0.5" movable="false">
      <body position="14, 14, 0" orientation="0, 0, 0.6" />
    </box>
    
    <!-- Bunker-like structures -->
    <box id="bunker_wall_1" size="3, 0.3, 0.5" movable="false">
      <body position="5, 15, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="bunker_wall_2" size="0.3, 2, 0.5" movable="false">
      <body position="3.5, 15.5, 0" orientation="0, 0, 0" />
    </box>
    
    <!-- Additional barriers creating maze-like paths -->
    <box id="barrier_2" size="2.5, 0.3, 0.5" movable="false">
      <body position="15, 6, 0" orientation="0, 0, 1.2" />
    </box>
    
    <box id="barrier_3" size="3, 0.3, 0.5" movable="false">
      <body position="8, 16, 0" orientation="0, 0, 0.5" />
    </box>

    <!-- GOAL MARKER - Visual destination point -->
    <cylinder id="goal_marker" radius="0.5" height="0.8" movable="false" mass="0.1">
      <body position="18, 18, 0" orientation="0, 0, 0" />
      <leds medium="leds">
        <led offset="0, 0, 0.4" anchor="origin" color="green" />
      </leds>
    </cylinder>

    <!-- Place 4 FootBots in starting positions (spread out in safe zones) -->
    
    <foot-bot id="fb0">
      <body position="2, 2, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb1">
      <body position="2, 6, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb2">
      <body position="6, 2, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb3">
      <body position="6, 6, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" iterations="10" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <led id="leds" />
  </media>

  <!-- ****************** -->
  <!-- * Visualization  * -->
  <!-- ****************** -->
  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <!-- Top-down view of the arena -->
          <placement index="0" position="10, 10, 15" look_at="10, 10, 0" up="0, 1, 0" lens_focal_length="30" />
          <!-- Side view -->
          <placement index="1" position="10, 0, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
          <!-- Isometric view -->
          <placement index="2" position="5, 5, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
