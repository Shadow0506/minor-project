<?xml version="1.0" ?>

<!--
  Q-Learning Swarm Experiment Configuration
  
  This file configures the ARGoS simulation environment:
  - 20x20m arena
  - 4 FootBots with Q-learning controllers
  - Goal position at (18, 18)
  - Physics engine settings
  - Visualization settings
-->

<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment length="0"
                ticks_per_second="10"
                random_seed="124" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <q_swarm_controller id="qsc"
                        library="/home/shadow56/Desktop/minor-project/controllers/q_swarm_controller/build/libq_swarm_controller">
      <actuators>
        <differential_steering implementation="default" />
      </actuators>
      <sensors>
        <footbot_proximity implementation="default" show_rays="true" />
        <positioning implementation="default" />
      </sensors>
      <params>
        <!-- Goal position (all robots share same goal) -->
        <goal_x value="18.0" />
        <goal_y value="18.0" />
        
        <!-- Movement velocity (cm/s for differential steering) -->
        <velocity value="10.0" />
        
        <!-- Maximum steps per episode before reset -->
        <max_steps value="500" />
        
        <!-- Maximum number of episodes to run -->
        <max_episodes value="1000" />
      </params>
    </q_swarm_controller>

  </controllers>

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="20, 20, 2" center="10, 10, 1">

    <!-- Floor -->
    <floor id="floor"
           source="loop_functions"
           pixels_per_meter="50" />

    <!-- Place 4 FootBots in starting positions -->
    <!-- Starting positions: spread out to avoid initial collisions -->
    
    <foot-bot id="fb0">
      <body position="2, 2, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb1">
      <body position="2, 6, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb2">
      <body position="6, 2, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb3">
      <body position="6, 6, 0" orientation="0, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" iterations="10" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <led id="leds" />
  </media>

  <!-- ****************** -->
  <!-- * Visualization  * -->
  <!-- ****************** -->
  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <!-- Top-down view of the arena -->
          <placement index="0" position="10, 10, 15" look_at="10, 10, 0" up="0, 1, 0" lens_focal_length="30" />
          <!-- Side view -->
          <placement index="1" position="10, 0, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
          <!-- Isometric view -->
          <placement index="2" position="5, 5, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
