<?xml version="1.0" ?>

<!--
  Q-Learning Swarm Experiment Configuration
  
  This file configures the ARGoS simulation environment:
  - 20x20m arena
  - 4 FootBots with Q-learning controllers
  - Goal position at (18, 18)
  - Physics engine settings
  - Visualization settings
-->

<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment length="0"
                ticks_per_second="10"
                random_seed="124" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <q_swarm_controller id="qsc"
                        library="/home/shadow56/Desktop/minor-project/controllers/q_swarm_controller/build/libq_swarm_controller">
      <actuators>
        <differential_steering implementation="default" />
      </actuators>
      <sensors>
        <footbot_proximity implementation="default" show_rays="true" />
        <positioning implementation="default" />
      </sensors>
      <params goal_x="18.0" goal_y="18.0" velocity="15.0" max_steps="1000" max_episodes="1000" />

    </q_swarm_controller>

  </controllers>

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="20, 20, 2" center="10, 10, 1">

    <!-- Floor -->
    <floor id="floor"
           source="loop_functions"
           pixels_per_meter="50" />

    <!-- Arena walls (outer boundary) -->
    <box id="wall_north" size="20, 0.1, 0.5" movable="false">
      <body position="10, 20, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_south" size="20, 0.1, 0.5" movable="false">
      <body position="10, 0, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_east" size="0.1, 20, 0.5" movable="false">
      <body position="20, 10, 0" orientation="0, 0, 0" />
    </box>
    <box id="wall_west" size="0.1, 20, 0.5" movable="false">
      <body position="0, 10, 0" orientation="0, 0, 0" />
    </box>

    <!-- MAZE STRUCTURE - Creating challenging paths that require swarm coordination -->
    
    <!-- Vertical maze walls -->
    <box id="maze_v1" size="0.3, 6, 0.5" movable="false">
      <body position="8, 7, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="maze_v2" size="0.3, 5, 0.5" movable="false">
      <body position="12, 8.5, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="maze_v3" size="0.3, 7, 0.5" movable="false">
      <body position="16, 6.5, 0" orientation="0, 0, 0" />
    </box>
    
    <!-- Horizontal maze walls -->
    <box id="maze_h1" size="6, 0.3, 0.5" movable="false">
      <body position="7, 11, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="maze_h2" size="5, 0.3, 0.5" movable="false">
      <body position="11.5, 14, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="maze_h3" size="4, 0.3, 0.5" movable="false">
      <body position="14, 7, 0" orientation="0, 0, 0" />
    </box>
    
    <!-- L-shaped obstacles creating narrow passages -->
    <box id="corner_wall_1a" size="3, 0.3, 0.5" movable="false">
      <body position="9.5, 15, 0" orientation="0, 0, 0" />
    </box>
    <box id="corner_wall_1b" size="0.3, 2, 0.5" movable="false">
      <body position="11, 14, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="corner_wall_2a" size="2.5, 0.3, 0.5" movable="false">
      <body position="5.75, 9, 0" orientation="0, 0, 0" />
    </box>
    <box id="corner_wall_2b" size="0.3, 2, 0.5" movable="false">
      <body position="7, 8, 0" orientation="0, 0, 0" />
    </box>
    
    <!-- Scattered obstacles in key positions -->
    <box id="obstacle_1" size="1.2, 1.2, 0.5" movable="false">
      <body position="10, 10, 0" orientation="0, 0, 0.5" />
    </box>
    
    <box id="obstacle_2" size="1.5, 1, 0.5" movable="false">
      <body position="14, 12, 0" orientation="0, 0, 0.3" />
    </box>
    
    <box id="obstacle_3" size="1, 1.5, 0.5" movable="false">
      <body position="6, 13, 0" orientation="0, 0, 0.8" />
    </box>
    
    <!-- Narrow corridor obstacles -->
    <box id="corridor_block_1" size="1, 0.3, 0.5" movable="false">
      <body position="11, 6, 0" orientation="0, 0, 0" />
    </box>
    
    <box id="corridor_block_2" size="0.3, 1.5, 0.5" movable="false">
      <body position="15, 11, 0" orientation="0, 0, 0" />
    </box>

    <!-- GOAL MARKER - Visual destination point in RED -->
    <cylinder id="goal_marker" radius="0.6" height="0.8" movable="false" mass="0.1">
      <body position="18, 18, 0" orientation="0, 0, 0" />
      <leds medium="leds">
        <led offset="0, 0, 0.4" anchor="origin" color="red" intensity="2.0" />
      </leds>
    </cylinder>

    <!-- Place 4 FootBots in CLOSER starting positions for better swarm coordination -->
    <!-- Starting in a tight formation at (4, 4) area -->
    
    <foot-bot id="fb0">
      <body position="3.5, 3.5, 0" orientation="0.785, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb1">
      <body position="4.5, 3.5, 0" orientation="0.785, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb2">
      <body position="3.5, 4.5, 0" orientation="0.785, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

    <foot-bot id="fb3">
      <body position="4.5, 4.5, 0" orientation="0.785, 0, 0" />
      <controller config="qsc" />
      <dynamics2d />
    </foot-bot>

  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" iterations="10" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <led id="leds" />
  </media>

  <!-- ****************** -->
  <!-- * Loop Functions * -->
  <!-- ****************** -->
  <loop_functions library="/home/shadow56/Desktop/minor-project/loop_functions/build/libq_swarm_loop_functions"
                  label="q_swarm_loop_functions">
    <params formation_size="5.0" />
  </loop_functions>

  <!-- ****************** -->
  <!-- * Visualization  * -->
  <!-- ****************** -->
  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <!-- Top-down view of the arena -->
          <placement index="0" position="10, 10, 15" look_at="10, 10, 0" up="0, 1, 0" lens_focal_length="30" />
          <!-- Side view -->
          <placement index="1" position="10, 0, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
          <!-- Isometric view -->
          <placement index="2" position="5, 5, 10" look_at="10, 10, 0" up="0, 0, 1" lens_focal_length="30" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
